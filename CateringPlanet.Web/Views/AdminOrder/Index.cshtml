@model IEnumerable<OrderDto>
@{
    ViewData["Title"] = "All Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statuses = ViewData["OrderStatuses"] as IEnumerable<OrderStatusDto> ?? Enumerable.Empty<OrderStatusDto>();
    var selectedStatusId = ViewData["SelectedStatusId"] as int?;
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentSort = ViewData["CurrentSort"] as string;
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 10;
    var totalItems = ViewData["TotalItems"] as int? ?? 0;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;

    // Maps an order status id to a Bootstrap badge class (covers all 8 seeded statuses).
    string BadgeClass(int statusId) => statusId switch
    {
        1 => "bg-secondary", // Primljena
        2 => "bg-info",      // Potvrđena
        3 => "bg-primary",   // U pripremi
        4 => "bg-primary",   // Spremna
        5 => "bg-info",      // U dostavi
        6 => "bg-success",   // Završena
        7 => "bg-danger",    // Otkazana
        8 => "bg-dark",      // Odbijena
        _ => "bg-secondary"
    };

    // Sort-direction arrow shown next to the active sortable column header.
    string Arrow(string asc, string desc) => currentSort == asc ? "↑" : currentSort == desc ? "↓" : "";
}

<div class="container col-xxl-12 px-4 py-5">
    <h2>Orders</h2>

    <!-- Search form -->
    <form method="get" asp-controller="AdminOrder" asp-action="Index" class="mb-3">
        <input type="hidden" name="statusId" value="@selectedStatusId" />
        <div class="input-group">
            <input type="text" name="searchString" value="@currentFilter" class="form-control" placeholder="Search by order ID, number, customer name or email..." />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                <a asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" class="btn btn-secondary">Clear</a>
            }
        </div>
    </form>

    <!-- Status filter -->
    <form method="get" asp-controller="AdminOrder" asp-action="Index" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label for="statusFilter" class="form-label">Filter by status</label>
            <select id="statusFilter" name="statusId" class="form-select">
                <option value="">All statuses</option>
                @foreach (var s in statuses)
                {
                    if (selectedStatusId.HasValue && s.Id == selectedStatusId.Value)
                    {
                        <option value="@s.Id" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    <a asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" asp-route-searchString="@currentFilter" asp-route-sortOrder="@(currentSort == "orderId_asc" ? "orderId_desc" : "orderId_asc")">Order ID @Arrow("orderId_asc", "orderId_desc")</a>
                </th>
                <th>Order number</th>
                <th>
                    <a asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" asp-route-searchString="@currentFilter" asp-route-sortOrder="@(currentSort == "customer_asc" ? "customer_desc" : "customer_asc")">Customer @Arrow("customer_asc", "customer_desc")</a>
                </th>
                <th>
                    <a asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" asp-route-searchString="@currentFilter" asp-route-sortOrder="@(currentSort == "date_asc" ? "date_desc" : "date_asc")">Date Created @Arrow("date_asc", "date_desc")</a>
                </th>
                <th>
                    <a asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" asp-route-searchString="@currentFilter" asp-route-sortOrder="@(currentSort == "total_asc" ? "total_desc" : "total_asc")">Total @Arrow("total_asc", "total_desc")</a>
                </th>
                <th>Payment</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.OrderNumber</td>
                    <td>@order.CustomerName</td>
                    <td>@order.DateCreated.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.TotalString RSD</td>
                    <td>
                        <span class="badge @(order.PaymentStatusId == 2 ? "bg-success" : order.PaymentStatusId == 1 ? "bg-warning" : "bg-secondary")">@order.PaymentStatusName</span>
                    </td>
                    <td>
                        <span class="badge @BadgeClass(order.StatusId)">@order.StatusName</span>
                    </td>
                    <td>
                        <a asp-controller="AdminOrder" asp-action="ViewOrder" asp-route-id="@order.Id" class="btn btn-sm btn-info">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <div class="text-muted small">
            Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, totalItems) of @totalItems orders
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Orders pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" asp-route-searchString="@currentFilter" asp-route-sortOrder="@currentSort" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int pageNum = 1; pageNum <= totalPages; pageNum++)
                {
                    <li class="page-item @(pageNum == currentPage ? "active" : "")">
                        <a class="page-link" asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" asp-route-searchString="@currentFilter" asp-route-sortOrder="@currentSort" asp-route-page="@pageNum">@pageNum</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="AdminOrder" asp-action="Index" asp-route-statusId="@selectedStatusId" asp-route-searchString="@currentFilter" asp-route-sortOrder="@currentSort" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
