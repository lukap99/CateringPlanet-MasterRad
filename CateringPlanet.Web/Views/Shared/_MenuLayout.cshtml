<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ketering Planet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.2/font/bootstrap-icons.css" />
</head>

<body class="bg-light d-flex flex-column min-vh-100">
    @if (User.IsInRole("Admin"))
    {
        <partial name="_navbarAdmin" />
    }
    else if (User.IsInRole("Manager"))
    {
        <partial name="_navbarManager" />
    }
    else if (User.IsInRole("Customer"))
    {
        <partial name="_navbarCustomer" />
    }
    else
    {
        <partial name="_navbarGuest" />
    }

    <main role="main" class="pb-3 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer border-top py-3 bg-dark">
        <div class="container text-center py-3">
            <span class="text-muted">Luka Popović 569/22. Ketering služba</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
