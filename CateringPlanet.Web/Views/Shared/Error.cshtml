@model ErrorViewModel
@{
    ViewData["Title"] = "Greška";
}

<h1 class="text-danger">Greška.</h1>
<h2 class="text-danger">Došlo je do greške prilikom obrade vašeg zahteva.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID zahteva:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Režim razvoja</h3>
<p>
    Prebacivanje na <strong>Development</strong> okruženje prikazaće detaljnije informacije o grešci koja je nastala.
</p>
<p>
    <strong>Development okruženje ne bi trebalo da bude omogućeno za objavljene aplikacije.</strong>
    Ono može dovesti do prikazivanja osetljivih informacija iz izuzetaka krajnjim korisnicima.
    Za lokalno ispravljanje grešaka, omogućite <strong>Development</strong> okruženje postavljanjem promenljive okruženja <strong>ASPNETCORE_ENVIRONMENT</strong> na vrednost <strong>Development</strong>
    i ponovo pokrenite aplikaciju.
</p>
