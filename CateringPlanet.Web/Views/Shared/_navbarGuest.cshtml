@inject ICartService CartService
@{
    var numItemsInCart = CartService.GetCart().ItemCount;
}

<!-- Guest (not signed in) -->
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom py-4">
    <div class="container px-5">

        <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="font-family:'Segoe UI Black'; font-size:2em;">
            <img src="~/images/ketering-logo-bw.png" style="height:50px;" alt="Logo" />
            Ketering Planet
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavDropdown">
            <ul class="navbar-nav ms-auto fs-5 text-primary">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Menu" asp-action="Index">Menu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Checkout" asp-action="Index">
                        @if (numItemsInCart > 0)
                        {
                            <span class="badge rounded-pill bg-primary">@numItemsInCart</span>
                        }
                        <i class="bi bi-cart"></i>
                        Cart
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-fill"></i>
                        Login/Register
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>
