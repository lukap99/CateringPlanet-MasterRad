@model FoodDto
@{
    ViewData["Title"] = "Delete food";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-xxl-4 px-4 py-3">
    <div class="card mb-2 px-0 py-0">
        <div class="card-body py-4 px-md-5">
            <form asp-controller="AdminMenu" asp-action="DeleteFood" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <h4>Are you sure you want to delete <span class="text-muted">"@Model.Name"</span>?</h4>
                <hr />
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-controller="AdminMenu" asp-action="Index" class="btn btn-primary">Back</a>
            </form>
        </div>
    </div>
</div>
