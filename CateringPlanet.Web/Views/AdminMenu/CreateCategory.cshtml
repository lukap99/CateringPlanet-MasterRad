@model FoodCategoryDto
@{
    ViewData["Title"] = "Create category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-xxl-4 px-4 py-3">
    <div class="card mb-2 px-0">
        <div class="card-body py-4 px-md-5">
            <form asp-controller="AdminMenu" asp-action="CreateCategory" method="post">
                <h4>Create new food category</h4>
                <hr />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Soups, Desserts" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiscountPercent" class="form-label">Discount percentage</label>
                    <div class="input-group" style="max-width: 40%;">
                        <input asp-for="DiscountPercent" type="number" min="0" max="100" step="0.01" class="form-control" />
                        <span class="input-group-text">%</span>
                    </div>
                    <small class="form-text text-muted">Leave 0 if no discount applies to the whole category.</small>
                </div>

                <input type="submit" value="Create Category" class="btn btn-success" />
                <a asp-controller="AdminMenu" asp-action="Index" class="btn btn-primary">Back</a>
            </form>
        </div>
    </div>
</div>
