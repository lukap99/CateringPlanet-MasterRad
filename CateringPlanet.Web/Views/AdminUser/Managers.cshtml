@model IEnumerable<UserDto>
@{
    ViewData["Title"] = "Managers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-xxl-8 px-4 py-5">
    <h2>Managers</h2>
    <a asp-controller="AdminUser" asp-action="CreateManager" class="btn btn-success mb-3"><i class="bi bi-plus-circle"> Add manager</i></a>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.FullName</td>
                    <td>@m.Email</td>
                    <td>
                        <a asp-controller="AdminUser" asp-action="EditManager" asp-route-id="@m.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-controller="AdminUser" asp-action="DeleteManager" asp-route-id="@m.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
