@model UserDto
@{
    ViewData["Title"] = "Korisnik - profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Admin view of a single customer profile -->
<div class="container col-5 py-5">

    <div class="card">
        <div class="card-body py-4 px-4">

            <h3>Korisnik</h3>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Id</div>
                <div style="font-size: 1.1em">@Model.Id</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Ime</div>
                <div style="font-size: 1.1em">@Model.FirstName</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Prezime</div>
                <div style="font-size: 1.1em">@Model.LastName</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">E-mail</div>
                <div style="font-size: 1.1em">@Model.Email</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Poeni</div>
                <div style="font-size: 1.1em">@Model.Points</div>

                <!-- Admin points adjustment: sets the balance to the entered value -->
                <form asp-controller="AdminUser" asp-action="UpdateUserPoints" method="post" class="d-flex gap-2 mt-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input name="points" type="number" min="0" step="1" value="@Model.Points" class="form-control" style="max-width: 120px;" />
                    <input type="submit" value="Sačuvaj poene" class="btn btn-sm btn-primary" />
                </form>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Telefon</div>
                <div style="font-size: 1.1em">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Adresa</div>
                <div style="font-size: 1.1em">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</div>
            </div>

            <a asp-controller="AdminUser" asp-action="EditCustomerProfile" asp-route-id="@Model.Id" class="btn btn-primary">Izmeni korisnika</a>
            <a asp-controller="AdminOrder" asp-action="Index" asp-route-userId="@Model.Id" class="btn btn-primary">Narudžbine korisnika</a>
            <a asp-controller="AdminUser" asp-action="Users" class="btn btn-outline-primary">Nazad</a>

        </div>
    </div>
</div>
