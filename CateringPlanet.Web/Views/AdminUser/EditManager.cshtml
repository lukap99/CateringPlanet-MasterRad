@model UserDto
@{
    ViewData["Title"] = "Edit manager";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-5 py-5">
    <div class="card">
        <div class="card-body py-4 px-4">
            <form asp-controller="AdminUser" asp-action="EditManager" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <h4>Edit manager</h4>
                <h5>id: @Model.Id - @Model.FullName</h5>
                <h5>E-mail: @Model.Email</h5>
                <hr />

                <div class="row">
                    <div class="col">
                        <label class="form-label">First name</label>
                        <input name="firstName" value="@Model.FirstName" class="form-control" />
                    </div>
                    <div class="col mb-3">
                        <label class="form-label">Last name</label>
                        <input name="lastName" value="@Model.LastName" class="form-control" />
                    </div>
                </div>

                <input type="submit" value="Edit manager" class="btn btn-success" />
                <a asp-controller="AdminUser" asp-action="Managers" class="btn btn-primary">Back</a>
            </form>
        </div>
    </div>
</div>
