@model IEnumerable<UserDto>
@{
    ViewData["Title"] = "Registrovani korisnici";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentSort = ViewData["CurrentSort"] as string;
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 10;
    var totalItems = ViewData["TotalItems"] as int? ?? 0;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;

    // Sort-direction arrow shown next to the active sortable column header.
    string Arrow(string asc, string desc) => currentSort == asc ? "↑" : currentSort == desc ? "↓" : "";
}

<div class="container col-xxl-8 px-4 py-5">
    <h2>Registrovani korisnici</h2>

    <!-- Search form -->
    <form method="get" asp-controller="AdminUser" asp-action="Users" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" value="@currentFilter" class="form-control" placeholder="Pretraži po imenu ili e-mailu..." />
            <button type="submit" class="btn btn-primary">Pretraži</button>
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                <a asp-controller="AdminUser" asp-action="Users" class="btn btn-secondary">Očisti</a>
            }
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    <a asp-controller="AdminUser" asp-action="Users" asp-route-searchString="@currentFilter" asp-route-sortOrder="@(currentSort == "name_desc" ? "name_asc" : "name_desc")">Ime @Arrow("name_asc", "name_desc")</a>
                </th>
                <th>
                    <a asp-controller="AdminUser" asp-action="Users" asp-route-searchString="@currentFilter" asp-route-sortOrder="@(currentSort == "email_asc" ? "email_desc" : "email_asc")">E-mail @Arrow("email_asc", "email_desc")</a>
                </th>
                <th>
                    <a asp-controller="AdminUser" asp-action="Users" asp-route-searchString="@currentFilter" asp-route-sortOrder="@(currentSort == "points_asc" ? "points_desc" : "points_asc")">Poeni @Arrow("points_asc", "points_desc")</a>
                </th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><a asp-controller="AdminUser" asp-action="ViewUser" asp-route-id="@user.Id">@user.FullName</a></td>
                    <td>@user.Email</td>
                    <td>@user.Points</td>
                    <td>
                        <a asp-controller="AdminUser" asp-action="EditCustomerProfile" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Izmeni</a>
                        <a asp-controller="AdminUser" asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Obriši</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <div class="text-muted small">
            Prikazano @((currentPage - 1) * pageSize + 1) do @Math.Min(currentPage * pageSize, totalItems) od @totalItems korisnika
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Paginacija korisnika">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="AdminUser" asp-action="Users" asp-route-searchString="@currentFilter" asp-route-sortOrder="@currentSort" asp-route-page="@(currentPage - 1)">Prethodna</a>
                </li>
                @for (int pageNum = 1; pageNum <= totalPages; pageNum++)
                {
                    <li class="page-item @(pageNum == currentPage ? "active" : "")">
                        <a class="page-link" asp-controller="AdminUser" asp-action="Users" asp-route-searchString="@currentFilter" asp-route-sortOrder="@currentSort" asp-route-page="@pageNum">@pageNum</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="AdminUser" asp-action="Users" asp-route-searchString="@currentFilter" asp-route-sortOrder="@currentSort" asp-route-page="@(currentPage + 1)">Sledeća</a>
                </li>
            </ul>
        </nav>
    }
</div>
