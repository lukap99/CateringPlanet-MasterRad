@model IEnumerable<UserDto>
@{
    ViewData["Title"] = "Registered Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container col-xxl-8 px-4 py-5">
    <h2>Registered Users</h2>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Points</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Points</td>
                    <td>
                        <a asp-controller="AdminUser" asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-controller="AdminUser" asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
