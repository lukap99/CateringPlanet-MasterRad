@model ComboMenuDto

@{
    var selectedCategoryId = ViewData["SelectedCategoryId"] is int sid ? sid : 0;
    var isComboMenuView = ViewData["IsComboMenuView"] is bool cv && cv;
}

<div class="card mb-2">
    <form asp-controller="Menu" asp-action="AddComboMenuToCart" method="post">
        <input type="hidden" name="ComboMenuId" value="@Model.Id" />
        <input type="hidden" name="selectedCategoryId" value="@selectedCategoryId" />
        <input type="hidden" name="isComboMenuView" value="@isComboMenuView" />

        <div class="row align-items-center">
            <div class="col-3">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid zoom" style="max-width: 100%; height: auto; margin: 10px" />
            </div>

            <div class="col-3">
                <div style="word-wrap: break-word;">
                    @if (Model.DiscountPercent > 0)
                    {
                        <h5 class="text-warning fw-bold">(@Model.DiscountPercent.ToString()% popust!)</h5>
                    }
                    <h5>@Model.Name</h5>
                    @if (Model.Items.Any())
                    {
                        <p class="text-muted">@Model.ListOfItems</p>
                    }
                </div>
            </div>

            <div class="col text-center">
                <h5>Cena</h5>
                @if (Model.DiscountPercent > 0)
                {
                    <h5 class="text-success text-decoration-line-through">@Model.PriceString RSD</h5>
                }
                <h4 class="text-success"><b>@Model.SellingPriceString RSD</b></h4>
            </div>

            <div class="col px-auto text-center">
                <h6>Broj</h6>
                <input type="number" name="Amount" value="@Model.Amount" min="1" class="form-control mb-2 mx-auto w-50" />
                <button type="submit" class="btn btn-outline-success"><i class="bi bi-cart-plus"> Dodaj u korpu</i></button>
            </div>
        </div>
    </form>
</div>
