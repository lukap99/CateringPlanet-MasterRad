@model EditAccountViewModel

@{
    ViewData["Title"] = "Detalji naloga";
}

<!-- Read-only account details -->
<div class="container col-5 py-5">

    <div class="card">
        <div class="card-body py-4 px-4">

            <h3>Detalji naloga</h3>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Ime</div>
                <div style="font-size: 1.1em">@Model.FirstName</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Prezime</div>
                <div style="font-size: 1.1em">@Model.LastName</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">E-mail</div>
                <div style="font-size: 1.1em">@Model.Email</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Poeni</div>
                <div style="font-size: 1.1em">@Model.Points</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Telefon</div>
                <div style="font-size: 1.1em">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</div>
            </div>

            <div class="mb-3">
                <div class="text-muted" style="font-size: 0.8em;">Adresa</div>
                <div style="font-size: 1.1em">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</div>
            </div>

            <a asp-controller="Account" asp-action="EditAccount" class="btn btn-primary">Izmeni profil</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Nazad</a>

        </div>
    </div>
</div>
