@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container col-xxl-8 px-4 py-5">
    <!-- Section: Design Block -->
    <section class="text-center text-lg-start">
        <div class="card mb-3">
            <div class="row g-0 d-flex align-items-center">

                <div class="col-lg-4 d-none d-lg-flex">
                    <img src="https://mdbootstrap.com/img/new/ecommerce/vertical/004.jpg" class="w-100 rounded-t-5 rounded-tr-lg-0 rounded-bl-lg-5" alt="Login" />
                </div>

                <div class="col-lg-8">
                    <div class="card-body py-5 px-md-5">

                        <form asp-controller="Account" asp-action="Login" method="post">
                            <!-- Keep the requested return URL across the form post -->
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div class="form-outline mb-4">
                                <h3>Login</h3>
                            </div>

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                            <!-- Email input -->
                            <div class="form-outline mb-4">
                                <input asp-for="Email" class="form-control" autocomplete="username" />
                                <label asp-for="Email" class="form-label"></label>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <!-- Password input -->
                            <div class="form-outline mb-4">
                                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                                <label asp-for="Password" class="form-label"></label>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <!-- Remember me -->
                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div>

                            <!-- Submit button -->
                            <button type="submit" class="btn btn-primary btn-block mb-4">Prijavi se</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Section: Design Block -->
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
